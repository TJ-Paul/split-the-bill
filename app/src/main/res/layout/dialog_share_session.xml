<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <!-- Live status: "Live · 2 people viewing" -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_pill_success"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <View
                android:id="@+id/vStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_live_dot" />

            <TextView
                android:id="@+id/tvShareStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/status_refund"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Live · 2 people viewing" />
        </LinearLayout>

        <!-- QR code and link -->
        <LinearLayout
            android:id="@+id/groupReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp">

                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="232dp"
                    android:layout_height="232dp"
                    android:contentDescription="@string/share_qr_desc"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/color_on_surface"
                android:textIsSelectable="true"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="http://192.168.43.1:8080" />

            <TextView
                android:id="@+id/tvNetworkLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.App.Label"
                tools:text="On your hotspot" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupNetworks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:selectionRequired="true"
                app:singleSelection="true"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyLink"
                    style="@style/Widget.App.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/share_copy_link"
                    app:icon="@drawable/ic_content_copy"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendLink"
                    style="@style/Widget.App.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share_send_link"
                    app:icon="@drawable/ic_share"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Not connected to Wi-Fi and no hotspot -->
        <LinearLayout
            android:id="@+id/groupNoNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="@color/color_primary_container"
                android:importantForAccessibility="no"
                android:padding="18dp"
                android:src="@drawable/ic_wifi_tethering"
                app:tint="@color/color_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/share_no_network_title"
                android:textAppearance="@style/TextAppearance.App.SectionTitle"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/share_no_network_body"
                android:textAppearance="@style/TextAppearance.App.Subtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHotspotSettings"
                style="@style/Widget.App.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/share_open_hotspot_settings"
                app:icon="@drawable/ic_wifi_tethering"
                app:iconSize="20dp" />
        </LinearLayout>

        <!-- Couldn't start -->
        <LinearLayout
            android:id="@+id/groupFailed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/share_failed_body"
                android:textAppearance="@style/TextAppearance.App.Subtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.App.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/share_retry" />
        </LinearLayout>

        <!-- How it works -->
        <TextView
            android:id="@+id/tvSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/share_steps"
            android:textColor="@color/color_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/share_tip"
            android:textAppearance="@style/TextAppearance.App.Label" />
    </LinearLayout>
</ScrollView>
