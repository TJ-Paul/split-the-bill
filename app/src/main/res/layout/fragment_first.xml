<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".FirstFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRestaurant"
            style="@style/Widget.App.TextInputLayout.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:hint="@string/restaurant_hint"
            app:endIconMode="clear_text"
            app:startIconContentDescription="@string/restaurant_icon_desc"
            app:startIconDrawable="@drawable/ic_restaurant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRestaurant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFriend"
                style="@style/Widget.App.Button.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/action_add_friend_hint"
                android:paddingHorizontal="8dp"
                android:text="@string/action_add_friend"
                app:icon="@drawable/ic_person_add"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickAdd"
                style="@style/Widget.App.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/action_recent_hint"
                android:paddingHorizontal="8dp"
                android:text="@string/action_recent"
                app:icon="@drawable/ic_history"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBulkAdd"
                style="@style/Widget.App.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/action_bulk_hint"
                android:paddingHorizontal="8dp"
                android:text="@string/action_bulk"
                app:icon="@drawable/ic_group_add"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="20dp" />
        </LinearLayout>

        <!-- Shown while friends can add orders from the shared web page -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/liveBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/share_banner_desc"
            android:visibility="gone"
            app:cardBackgroundColor="@color/status_refund_container"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="4dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_live_dot" />

                <TextView
                    android:id="@+id/tvLiveBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/status_refund"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Sharing live · 2 people viewing" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLiveShowQr"
                    style="@style/Widget.App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share_show_qr"
                    android:textColor="@color/status_refund"
                    app:icon="@drawable/ic_qr_code"
                    app:iconSize="18dp"
                    app:iconTint="@color/status_refund" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="88dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_order" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="40dp"
                android:paddingBottom="48dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/color_primary_container"
                    android:importantForAccessibility="no"
                    android:padding="20dp"
                    android:src="@drawable/ic_groups"
                    app:tint="@color/color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/empty_title"
                    android:textAppearance="@style/TextAppearance.App.SectionTitle"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/empty_body"
                    android:textAppearance="@style/TextAppearance.App.Subtitle" />
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fabAddFood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="@string/add_food_hint"
                android:text="@string/add_food"
                app:icon="@drawable/ic_fastfood" />
        </FrameLayout>

        <!-- Live bill summary -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summaryBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/color_surface_container_lowest"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/color_outline_variant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSummaryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        tools:text="5 friends · Total bill" />

                    <TextView
                        android:id="@+id/tvSummaryTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_on_surface"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="4,500 tk" />

                    <TextView
                        android:id="@+id/tvSummaryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="13sp"
                        tools:text="Paid 3,000 · Due 1,700 · Refund 200" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReceipt"
                    style="@style/Widget.App.Button.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/summary_view_receipt"
                    app:icon="@drawable/ic_receipt"
                    app:iconSize="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
